# Copy to .env (git-ignored) and fill in. Read by docker compose and passed to the containers.

# Hugging Face (token with write access) and Weights & Biases
HF_TOKEN=
HF_DATASET_REPO=your-hf-username/registre-data
WANDB_API_KEY=

# Telegram (step 2): token from @BotFather, your numeric user id from getUpdates
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# vLLM: pin a release tag from https://hub.docker.com/r/vllm/vllm-openai/tags (never "latest")
VLLM_TAG=
# Only if your driver is older than the image's CUDA (e.g. driver CUDA 12.7, image cu129):
# skips the container toolkit's version check. Remove after upgrading the driver.
# NVIDIA_DISABLE_REQUIRE=true
SMOKE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GPU_MEM_UTIL=0.8

# Optional: exact URL of Tatoeba's spa–fra links file, if the guessed one in scripts/download.sh fails
TATOEBA_LINKS_URL=

# Day 2. No comments on the same line as a value: `docker run --env-file` would keep them.
# m or f: used for your own sentences (test_own)
SPEAKER_GENDER=
# only if the teacher is an API (generate.py --backend openai)
TEACHER_API_KEY=
# LanguageTool image tag
LT_TAG=6.8
